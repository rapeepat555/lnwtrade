{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user gamification and profile data",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "level": { "type": "number" },
        "exp": { "type": "number" },
        "statPoints": { "type": "number" },
        "rank": { "type": "string" },
        "skills": { 
          "type": "object",
          "properties": {
            "discipline": { "type": "number" },
            "riskManagement": { "type": "number" },
            "technicalAnalysis": { "type": "number" },
            "psychology": { "type": "number" }
          }
        }
      },
      "required": ["name", "level", "exp", "statPoints", "rank", "skills"]
    },
    "Quest": {
      "title": "Quest",
      "description": "A mission or task for the user",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "rewardExp": { "type": "number" },
        "rewardStat": { "type": "string" },
        "rewardStats": { "type": "array" },
        "rewardStatValue": { "type": "number" },
        "isCompleted": { "type": "boolean" },
        "type": { "type": "string", "enum": ["main", "sub", "daily"] },
        "isRecurring": { "type": "boolean" },
        "lastCompletedAt": { "type": "string" },
        "completedStatBoosts": { "type": "object" },
        "completedLevelUp": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "description", "rewardExp", "isCompleted", "type"]
    },
    "Trade": {
      "title": "Trade",
      "description": "A trading log entry",
      "type": "object",
      "properties": {
        "symbol": { "type": "string" },
        "type": { "type": "string", "enum": ["long", "short"] },
        "entryPrice": { "type": "number" },
        "exitPrice": { "type": "number" },
        "quantity": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "result": { "type": "string", "enum": ["win", "loss", "breakeven", "pending"] },
        "pnl": { "type": "number" },
        "rr": { "type": "number" },
        "setup": { "type": "string" },
        "session": { "type": "string" },
        "zone": { "type": "string" },
        "notes": { "type": "string" },
        "commission": { "type": "number" },
        "entryDate": { "type": "string", "format": "date-time" },
        "exitDate": { "type": "string", "format": "date-time" },
        "portfolioId": { "type": "string" },
        "stopLoss": { "type": "number" },
        "takeProfit": { "type": "number" }
      },
      "required": ["symbol", "type", "entryPrice", "quantity", "status", "result", "entryDate", "portfolioId"]
    },
    "Portfolio": {
      "title": "Portfolio",
      "description": "A collection of trades",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "balance": { "type": "number" },
        "initialBalance": { "type": "number" },
        "currency": { "type": "string" }
      },
      "required": ["name", "balance", "initialBalance", "currency"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A deposit, withdrawal or adjustment to a portfolio",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["deposit", "withdraw", "adjustment"] },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "portfolioId": { "type": "string" }
      },
      "required": ["type", "amount", "date", "portfolioId"]
    },
    "Backtest": {
      "title": "Backtest Session",
      "description": "A collection of simulated trades for a strategy",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "symbol": { "type": "string" },
        "setup": { "type": "string" },
        "dateTime": { "type": "string" },
        "session": { "type": "string" },
        "zone": { "type": "string" },
        "rr": { "type": "number" },
        "actualRr": { "type": "number" },
        "result": { "type": "string", "enum": ["win", "loss", "breakeven"] },
        "position": { "type": "string", "enum": ["buy", "sell"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["symbol", "setup", "dateTime", "session", "zone", "rr", "result", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/quests/{questId}": {
      "schema": "Quest",
      "description": "User specific quests"
    },
    "/users/{userId}/trades/{tradeId}": {
      "schema": "Trade",
      "description": "User trading logs"
    },
    "/users/{userId}/portfolios/{portfolioId}": {
      "schema": "Portfolio",
      "description": "User portfolios"
    },
    "/users/{userId}/portfolios/{portfolioId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Transactions for a portfolio"
    },
    "/users/{userId}/backtests/{backtestId}": {
      "schema": "Backtest",
      "description": "Backtesting sessions"
    }
  }
}
